# DriveDoc backend configuration.
# Copy to .env and fill in. Never commit the filled-in file.

# --- Required: the server refuses to start without these ---------------------
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/drivedoc
# Use a long random value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Core ---------------------------------------------------------------------
PORT=5000
JWT_EXPIRE=7d
# 'development' locally, 'production' on the host. In production the auth cookie
# is set Secure + SameSite=None, which http://localhost silently drops — so
# leaving this as 'production' locally makes cookie auth untestable.
NODE_ENV=development
# Where the frontend is served from. Used for CORS and for password reset links,
# so point it at http://localhost:5173 while developing locally.
CLIENT_URL=http://localhost:5173
# Where THIS API is reachable from the public internet. Used to build
# unsubscribe links, which are opened from an email client and so cannot be
# relative. Set it to your Render URL in production.
API_PUBLIC_URL=http://localhost:5000

# --- Google sign-in -----------------------------------------------------------
# The OAuth client ID from Google Cloud Console. The backend verifies that every
# Google ID token was issued for THIS client — without it, a token from any
# other Google app could sign in as that user.
GOOGLE_CLIENT_ID=

# --- Web push -----------------------------------------------------------------
# Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address Google/Mozilla push services can reach you on.
VAPID_CONTACT_EMAIL=support@drivedoc.org

# --- Transactional email (password reset) -------------------------------------
# From https://resend.com. If left blank, reset emails are logged to the console
# instead of sent, so the flow is still testable locally.
RESEND_API_KEY=
# Must be a domain you've verified with Resend. 'onboarding@resend.dev' works
# for testing but only delivers to your own Resend account address.
#
# The same key sends expiry reminder emails, which are the only reminder
# channel that reaches every user — push needs a granted permission and, on
# iOS, an installed PWA. Without this key, reminders go to the log only.
MAIL_FROM=DriveDoc <onboarding@resend.dev>

# --- Driving school search ----------------------------------------------------
# Google Maps Platform key, from https://console.cloud.google.com — enable
# "Places API (New)" and restrict the key to that API.
#
# This key stays SERVER-SIDE. Never expose it to the browser as a VITE_ var:
# anyone could then run up your bill. If this is blank the search silently
# falls back to OpenStreetMap, which is free but has patchier coverage and
# often no phone numbers.
#
# Billing: the field mask in services/places/google.js asks for phone numbers,
# which is an Enterprise-tier field, so each search bills at Enterprise —
# 1,000 free calls/month, then roughly $35/1,000. Results are cached in memory
# for 30 minutes, the endpoint requires a signed-in user, and it is rate
# limited to 30 searches per user per 15 minutes. Set a daily quota cap in the
# Cloud Console as the hard stop.
GOOGLE_PLACES_API_KEY=

# --- Scheduled expiry sweep ---------------------------------------------------
# Shared secret for POST /api/jobs/notify-expiring. Send it as the
# 'x-cron-secret' header. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Set to true to stop the 60s dev-mode sweep from running locally.
DISABLE_DEV_SWEEP=false

# --- Consent ------------------------------------------------------------------
# Bump when you materially change the Terms. Stored against each signup so you
# can tell which version a user accepted.
TERMS_VERSION=2026-10-07
